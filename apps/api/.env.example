# --- Base de données (Neon) ---
# Chaîne "pooled" fournie par Neon (Dashboard > Connection details > Pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/sama360?sslmode=require
# Chaîne directe (non poolée) pour les migrations
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/sama360?sslmode=require

# --- Redis (files d'événements BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=3000
NODE_ENV=development

# --- Sécurité ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
OTP_SECRET=change-me-otp-secret-at-least-32-chars

# --- OTP ---
# console : le code s'affiche dans les logs (développement uniquement ; refusé en production)
# orange  : Orange SMS API (developer.orange.com > SMS Senegal)
# twilio  : Twilio (nom d'expéditeur à enregistrer pour Orange et Expresso au Sénégal)
OTP_PROVIDER=console
# ORANGE_SMS_CLIENT_ID=
# ORANGE_SMS_CLIENT_SECRET=
# ORANGE_SMS_SENDER=+2210000
# ORANGE_SMS_SENDER_NAME=Sama360
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=Sama360
# TWILIO_MESSAGING_SERVICE_SID=

# --- Fichiers (logos, photos) ---
# local : disque (développement, VPS avec volume) ; s3 : Cloudflare R2, AWS S3… (obligatoire sur Render)
STORAGE_DRIVER=local
# S3_BUCKET=sama360-fichiers
# S3_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Hébergement ---
# TRUST_PROXY=1          derrière Render, Caddy, Nginx… (vraie IP du client pour les limites)
# MIGRATE_ON_START=true  l'API applique les migrations au démarrage
# RUN_WORKER=true        le worker tourne dans le process de l'API (un seul service)
