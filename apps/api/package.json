{
  "name": "@sama360/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @sama360/contracts build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @sama360/contracts build && tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @sama360/contracts build && tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:dev": "pnpm --filter @sama360/contracts build && tsc-watch -p tsconfig.build.json --onSuccess \"node dist/worker.js\"",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@sama360/contracts": "workspace:*",
    "bullmq": "^5.30.0",
    "drizzle-orm": "^0.38.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-watch": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
