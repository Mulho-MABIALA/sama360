# Copier en .env et remplir. Ne JAMAIS envoyer ce fichier sur GitHub.
API_DOMAIN=api.exemple.sn

# Neon (ou PostgreSQL) : rôle applicatif sama_app, et propriétaire pour les migrations
DATABASE_URL=
DATABASE_URL_DIRECT=

# Trois secrets différents d'au moins 32 caractères : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=

# SMS de connexion : orange ou twilio
OTP_PROVIDER=orange
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=+2210000
# ORANGE_SMS_SENDER_NAME=Sama360   (nom d'expéditeur, après validation par Orange)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Fichiers : sur le disque du serveur (volume « files ») par défaut ; ou S3/R2 :
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
