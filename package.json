{
  "name": "sama360",
  "private": true,
  "description": "Sama360 — super app multiservice (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @sama360/contracts build && pnpm --filter @sama360/api dev",
    "worker": "pnpm --filter @sama360/api worker",
    "db:migrate": "pnpm --filter @sama360/api db:migrate",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @sama360/api test:e2e",
    "typecheck": "pnpm -r typecheck"
  }
}
